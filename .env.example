# Ejemplo de configuración local. Copiar a `.env` si hace falta.
# Nunca commitear `.env` con valores reales.

# Directorio de datos (por defecto ~/Library/Application Support/FinanzAR)
FINANZAR_DATA_DIR=

# Host y puerto del backend local (debe permanecer en 127.0.0.1)
FINANZAR_HOST=127.0.0.1
FINANZAR_PORT=8765

# Nivel de log del backend
FINANZAR_LOG_LEVEL=INFO

# Repositorio de GitHub para el updater
FINANZAR_UPDATE_REPO=finanzar/finanzar-local

# Permitir el endpoint de datos demo (solo desarrollo)
FINANZAR_ALLOW_SEED=0

# Binario de llama-server (opcional; si no, se autodetecta)
FINANZAR_LLAMA_SERVER=
