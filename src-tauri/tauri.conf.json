{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinanzAR",
  "version": "0.2.5",
  "identifier": "com.finanzar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FinanzAR Desktop",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Finanzas personales local-first con OCR y copiloto.",
    "longDescription": "FinanzAR Desktop ordena tus finanzas a partir de resúmenes de tarjeta en PDF, con OCR local, copiloto explicable y memoria semántica en tu dispositivo.",
    "copyright": "© 2026 FinanzAR Desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/finanzar-backend"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "resources": {
      "../models/manifest.json": "models/manifest.json"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Lautaro005/finanzar-desktop/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNjA0Mjk4REJDNzZDRDMKUldUVGJNZmJtRUpnSWh0OXE0NUozbGhmUFN1MWNkRmZLK1lGZGIxMVYxYzNtd0JqempldGd0WG0K"
    }
  }
}
